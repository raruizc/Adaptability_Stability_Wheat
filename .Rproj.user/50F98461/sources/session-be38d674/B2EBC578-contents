##### Analisando por ano 
i = 6
for (i in 6:ncol(dados))
{
  cat("------------------------------------------------------------------", "\n")
  cat("ANAVA POR ANO", colnames(dados)[i], "\n")
  cat("------------------------------------------------------------------", "\n")
  dados.i <- dados[,c(1:5,i)]
  dados.i <- na.omit(dados.i)
  nomamb <- levels(droplevels(dados.i)$ANO)
  
  statsamb <- matrix(0, nlevels(droplevels(dados.i)$ANO),6)
  rownames(statsamb) <- levels(droplevels(dados.i)$ANO)
  colnames(statsamb) <- c("QME", "CVe", "Acuracia", "Fc Genot", "Pr > Fc", "Shapiro_P-value")
  
  j=1
  for (j in 1:nlevels(droplevels(dados.i)$ANO))
  {
    cat("------------------------------------------------------------------", "\n")
    cat("Anova - Variavel:", nomamb[j], colnames(dados)[i], "\n")
    cat("------------------------------------------------------------------", "\n")
    lmer.i <- lmer(dados.i[dados.i$ANO==nomamb[j],ncol(dados.i)] ~ REP + (1|REP:IBLOCK) + TREATMENT, data=dados.i[dados.i$ANO==nomamb[j],])
    print(lrt.i <- ranova(lmer.i))
    print(anova.i <- anova(lmer.i))
    GLe.i <- anova.i$DenDF[2]
    
    statsamb[nomamb[j],1] <- sigma(lmer.i)^2
    statsamb[nomamb[j],2] <- sqrt(statsamb[nomamb[j],1])/mean(dados.i[dados.i$ANO==nomamb[j],ncol(dados.i)])*100
    statsamb[nomamb[j],3] <- sqrt(1-1/anova.i$'F value'[2])
    statsamb[nomamb[j],4] <- anova.i$'F value'[2]
    statsamb[nomamb[j],5] <- anova.i$'Pr(>F)'[2]
    
    resid <- residuals(lmer.i)
    statsamb[nomamb[j],6] <- shapiro.test(resid)$ p.value
    
    qqnorm(resid, main = paste("Normal Q-Q Plot of" , nomamb[j], colnames(dados)[i]))
    #identify(qqnorm(resid, main = paste("Normal Q-Q Plot of" , nomamb[j], colnames(dados)[i])))
    #dados.ij <- dados.i[dados.i$ANO==nomamb[j],]
    #dados.ij[c(1, 33),]
    
  }
  
  #cat("Anovas Individuais (Local) - Variavel:", colnames(dados)[i], "\n")
  print(statsamb)
  cat("Teste de Hartley - Variavel:", colnames(dados)[i], "\n")
  print("Fmax"); print(Fmax <- max(statsamb[,1])/min(statsamb[,1]))
  print("P > Fmax"); print(Pvalor <- SuppDists::pmaxFratio(q = Fmax, df = GLe.i, k=nlevels(droplevels(dados.i)$ANO), lower.tail=F, log.p=FALSE))
  if (Pvalor < 0.05) print("Variancias residuais heterogeneas - Modelo heterocedastico indicado") else print("Variancias residuais homogeneas")
  
}


#### Analises Multilanos ####

nom_traits <- c("Altura da planta (cm)", "Peso do Hectolitro (Kg/hL)", "Peso de mil sementes (g)",  "Rendimento de grãos (kg/ha)")
# nom_traits <- c("Altura da planta (cm)", "Peso do Hectolitro (Kg/hL)",  "Rendimento de grãos (kg/ha)")

i = 6

for (i in 6:ncol(dados))
{
  cat("------------------------------------------------------------------", "\n")
  cat("ANAVA MULTIANOS", colnames(dados)[i], "\n")
  cat("------------------------------------------------------------------", "\n")
  dados.i <- dados[,c(1:5,i)]
  dados.i <- na.omit(dados.i)
  
  gls.y <- lmer(dados.i[,ncol(dados.i)] ~ ANO + ANO:REP + (1|ANO:REP:IBLOCK) + TREATMENT + ANO:TREATMENT, data=dados.i)
  
  # if (colnames(dados)[i] == "PROD_CORR") {
  #      gls.y <- gls(dados.i[,ncol(dados.i)] ~ LOCAL + LOCAL:REP + TREATMENT + 
  #                     LOCAL:TREATMENT, weights = varIdent(form= ~ 1|LOCAL), data=dados.i)}
  
  #print(summary(gls.y))
  print(anova.i <- data.frame(anova(gls.y)))
  
  ##Least Square Means - Scott-Knott ####
  ### Main effect of Cultivar ####
  medg.i <- summary(emmeans(gls.y, ~TREATMENT))
  x.i <- cbind(medg.i[,1],medg.i[,2])
  nobs <- nlevels(droplevels(dados.i)$ANO)*nlevels(droplevels(dados.i)$REP)
  mult <- matrix(1,nobs,1)
  xk.i <- kronecker(x.i,mult)
  
  GLe.i <- mean(medg.i$df,na.rm = T)
  ve.i <- mean(medg.i$SE^2, na.rm = T)*nobs
  SSe.i <- ve.i*GLe.i
  
  #result1 <- ExpDes::scottknott(xk.i[,2], xk.i[,1], round(GLe.i,digits=0), SSe.i, alpha = 0.05)
  
  #Using a function SK - Scott-Knott at the end of this file
  result <- SK(xk.i[,2], xk.i[,1], round(GLe.i,digits=0), SSe.i, alpha = 0.05, debug=TRUE)
  result$Treatments <- as.character(result$Treatments)
  result$Treatments <- as.numeric(result$Treatments)
  result <- result[order(result$Treatments),]
  
  medg.i$SK <- result$Groups
  
  #Plotting a catterpillar with grouping of SK
  tiff(filename = paste(paste(colnames(dados)[i],".tiff", sep = "_")), width = 4, height = 5, units = "in", res = 300, compression = "lzw")
  
  color_pallete_function <- colorRampPalette(
    colors = c("black", "blue", "red"),
    space = "Lab" # Option used when colors do not represent a quantitative scale
  )
  num_colors <- length(unique(medg.i$SK))
  SK_colors <- color_pallete_function(num_colors)
  
  print(ggplot(medg.i, aes(y=reorder(TREATMENT,emmean), x=emmean, color = SK)) + #sort the hybrids by the values of the BLUPs
          labs (x = nom_traits[i-5], y = "Cultivares") +
          geom_point() +
          geom_vline(xintercept = mean(dados.i[,ncol(dados.i)], na.rm = T), col = "red") +
          geom_errorbarh(aes(xmin=lower.CL,
                             xmax=upper.CL), height=0.5) +
          theme(axis.text.x = element_text(color="black"),
                axis.text.y = element_text(color="black")) +
          theme(legend.position = "none")) #hide the legend
  
  dev.off()
  
  ### G x E means - Variedade x amb####
  medge.i <- summary(emmeans(gls.y, ~ TREATMENT:ANO))
  medge.i$SK <- NA
  
  nAmb <- unique(medge.i$ANO)
  
  #iAmb="2022"
  
  for (iAmb in nAmb)
  {
    medge.ii <- medge.i[medge.i$ANO==iAmb,]
    x.i <- cbind(medge.ii[,1],medge.ii[,3])
    nrep <- nlevels(droplevels(dados.i)$REP)
    mult <- matrix(1,nrep,1)
    xk.i <- kronecker(x.i,mult)
    
    GLe.i <- mean(medge.ii$df,na.rm = T)
    ve.i <- mean(medge.ii$SE^2, na.rm = T)*nrep
    SSe.i <- ve.i*GLe.i
    
    #Using a function SK - Scott-Knott at the end of this file
    result <- SK(xk.i[,2], xk.i[,1], round(GLe.i,digits=0), SSe.i, alpha = 0.05, debug=TRUE)
    result$Treatments <- as.character(result$Treatments)
    result$Treatments <- as.numeric(result$Treatments)
    result <- result[order(result$Treatments),]
    
    medge.ii$SK <- result$Groups
    medge.i[medge.i$ANO==iAmb,] <- medge.ii
  }
  
  tiff(filename = paste(colnames(dados)[i],"GE",".tiff", sep = "_"), width = 5, height = 10, units = "in", res = 300, compression = "lzw")
  
  color_pallete_function <- colorRampPalette(
    colors = c("black", "blue", "red"),
    space = "Lab" # Option used when colors do not represent a quantitative scale
  )
  num_colors <- length(unique(medge.i$SK))
  SK_colors <- color_pallete_function(num_colors)
  
  #Plotting a catterpillar with grouping of SK - ordered for the first label of the facets
  nl <- nlevels(medge.i$TREATMENT)
  medge.test <- medge.i %>% 
    ungroup() %>% # As a precaution / handle in a separate .grouped_df method
    arrange(ANO, emmean)
  medge.test <- medge.test %>%
    mutate(TREATMENT=factor(TREATMENT, levels=medge.test$TREATMENT[1:nl]))
  
  #Plotting a vertical line by Amb within facets
  mean_y <- data.frame(tapply(medge.test$emmean, medge.test$ANO, mean))
  mean_y$ANO <- rownames(mean_y)
  colnames(mean_y) <- c("emmean","ANO")
  
  print(ggplot(medge.test, aes(y=TREATMENT,x=emmean, color = SK)) +
          labs (x = nom_traits[i-5], y = "Cultivares") +
          geom_point() +
          geom_errorbarh(aes(y=TREATMENT, xmin=lower.CL,
                             xmax=upper.CL), height=0.5) +
          geom_vline(aes(xintercept = emmean), col = "red", mean_y) +
          theme(axis.text.x = element_text(color="black", size = 7),
                axis.text.y = element_text(color="black", size = 7)) +
          facet_wrap(~ANO, scales = "free_y" ,nrow = 5, ncol = 1, strip.position = "right") +
          theme(legend.position = "none")) #hide the legend
  dev.off()
  
}



